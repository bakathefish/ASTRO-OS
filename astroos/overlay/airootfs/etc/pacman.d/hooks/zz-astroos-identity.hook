# AstroOS distro identity enforcement.
# cachyos-hooks ships /usr/share/libalpm/hooks/{cachyos-branding,lsb-release}.hook
# whose script rewrites /etc/os-release + /etc/lsb-release to CachyOS on every
# trigger (this is what clobbered the pre-placed identity in ISO build 13).
# Those hooks are masked at ISO build time (same-name /dev/null symlinks in this
# directory); this hook is the enforcement layer: named zz- so it sorts after
# every stock hook and re-asserts AstroOS identity last. It also keeps installed
# systems branded across filesystem/cachyos-hooks/lsb-release upgrades.
[Trigger]
Operation = Install
Operation = Upgrade
Type = Package
Target = filesystem
Target = cachyos-hooks
Target = cachyos-settings
Target = lsb-release

[Action]
Description = AstroOS: enforce distro identity (os-release, lsb-release)
When = PostTransaction
Exec = /bin/sh -c "cp /usr/share/astroos/branding/os-release /etc/os-release; cp /usr/share/astroos/branding/os-release /usr/lib/os-release; cp /usr/share/astroos/branding/lsb-release /etc/lsb-release"
