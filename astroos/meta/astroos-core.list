# astroos-core: the everyday base (installed by default)
# One package per line. '#' comments and blank lines ignored by gen-packages.sh.
# Some entries duplicate the pinned base list ON PURPOSE (council R2, B1): that
# base is CachyOS-Live-ISO's packages_desktop.x86_64 (astroos/base.lock), a git
# profile input, not the [cachyos] binary repo, which AstroOS no longer enables.
# These lists declare AstroOS intent; the build dedupes against the base at
# build time, and keeping them here protects us if upstream drops one.

# Base system / boot
base
base-devel
# linux-astroos / linux-astroos-lts: AstroOS builds these itself from the
# CachyOS kernel patch set and ships them signed from the [astroos] repo.
# Nothing here comes from the [cachyos] binary repo, which is no longer enabled.
linux-astroos
linux-astroos-lts
linux            # vanilla kernel, rescue fallback (council R2, C4)
linux-firmware
btrfs-progs
snapper
snap-pac
grub
grub-btrfs
efibootmgr
plymouth

# Desktop (KDE Plasma / Wayland)
plasma-meta
sddm
konsole
dolphin
ark
gwenview
okular
spectacle
kdeconnect

# Everyday apps
firefox
libreoffice-fresh
mpv
vlc

# Dev environment
git
neovim
tmux
ripgrep
fd
fzf
zoxide
starship
zsh
docker
podman
gcc
clang
llvm
rust
go
zig
python
nodejs
npm
deno
qemu-full
virt-manager

# Convenience layer
copyq
atuin
tesseract
tesseract-data-eng
informant         # Arch-news gate for pacman; was AUR-only, in [extra] since 2026-09 (R3 D6 migration)

# Performance / reliability daemons
reflector
earlyoom
ananicy-cpp
irqbalance
zram-generator

# Dev-loop accelerators
distrobox
uv
direnv
ccache
sccache

# Flatpak escape hatch
flatpak
