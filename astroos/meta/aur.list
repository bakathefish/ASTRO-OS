# Left the CachyOS repos with them 2026-09-06: [cachyos] is deleted from every
# pacman.conf, and these eight are not in Arch core/extra/multilib and are not
# CachyOS-branded, so they keep their upstream names and build here instead.
# None of them pulls an AUR-only dependency: the transitive block below is unchanged.
paru              # AUR helper. makedepends cargo (extra/rust provides it); depends git,
                  # pacman and libalpm.so>=14, and core/pacman 7.1.0 provides libalpm.so=16
                  # (AUR HEAD 329be21 "Add support for libalpm16" covers that ABI bump).
ckbcomp           # Calamares' keyboard module runs it to turn the chosen XKB layout into a
                  # console keymap. Debian console-setup upstream, built from a release
                  # tarball; depends perl, makedepends git. The name is also in the BlackArch
                  # db, where repo order resolves it to [astroos] first (R4 review D-D).
zfs-utils         # ZFS userspace ONLY (configure --with-config=user): no kernel dependency,
                  # so this IS the right AUR package for a distribution kernel. It carries no
                  # module. zfs-linux/-lts pin one exact kernel package version and would need
                  # a rebuild at every bump, and zfs-linux-cachyos left with [cachyos]. The
                  # module side is ours now: linux-astroos-zfs and linux-astroos-lts-zfs are
                  # built from the same PKGBUILD as their kernels, so they are always matched,
                  # and no DKMS is involved. This package is the userspace half of that pair,
                  # so its version must track what those modules were built against.
mkinitcpio-openswap  # hard depends of astroos-calamares-installer (the initcpiocfg module adds
                  # the openswap hook for encrypted swap and luksopenswaphookcfg writes
                  # /etc/openswap.conf). It never appeared in a package list: it reached the
                  # ISO only as a transitive dependency of cachyos-calamares-next, served by
                  # [cachyos]. 0.1.1-1, arch any, depends mkinitcpio only, no makedepends.
fish-autopair     # hard depends of astroos-fish-config: auto-closes brackets and quotes
                  # in fish. 1.0.4-2, arch any, depends fish, makedepends git. Served by
                  # [cachyos] until 2026-09-06 and not in Arch; the first scope-36 run
                  # failed astroos-fish-config on it. Built from a signed git tag: the
                  # author's key is vendored under aur-patches/fish-autopair/keys/pgp.
fish-pure-prompt  # hard depends of astroos-fish-config: the pure prompt the shipped
                  # config loads (its colours come from the AstroOS palette).
                  # 4.18.0-1, arch any, depends fish, no makedepends. Same provenance.
zotero-bin        # the reference manager of astroos-research.list, which named it as
                  # "zotero": that name is served by [cachyos] only, so the first ISO
                  # build without [cachyos] failed at pacstrap on it. The -bin package
                  # repacks the upstream release (10.0.1-1, provides zotero, depends
                  # alsa-lib gtk3 nss, no makedepends); AUR "zotero" builds from source
                  # with npm and is not worth a container hour for the same binary.
localsend-bin     # the AirDrop equivalent of astroos-continuity.list ("localsend"),
                  # same story: [cachyos]-only under that name, pacstrap failed on it.
                  # 1.18.0-1, provides localsend, depends fuse2 xdg-user-dirs
                  # libayatana-appindicator, no makedepends. AUR "localsend" builds
                  # with fvm, an AUR-only makedepends, which the scope rules exclude.

# Transitive AUR dependencies of the packages above (council R3.1 P2,
# explicit allowlist, measured closure 2026-08-25; consumer in parens)
cdsclient                # astromatic-scamp
clhep                    # geant4
healpix                  # python-healpy
python-aioftp            # python-sunpy
python-parfive           # python-sunpy
python-async-timeout     # python-aioftp (checkdepends)
python-siosocks          # python-aioftp (checkdepends + optdepends)
# python-sphinx-automodapi, python-sphinx_contributors: were python-parfive's
# docs-only makedepends; sphinx_contributors no longer builds under flit_core 4
# (2026-09-05), and the -doc split was never shipped. aur-patches/python-parfive
# drops the docs build, so both left the scope (R3 D6: maintenance surface).
python-fleep             # opendrop
# python-pytest-runner: was opendrop's checkdepend; its check() no longer runs on the
# Python 3.14 stack (pkg_resources gone) and aur-patches/opendrop drops it (2026-09-05).
python-rustworkx         # python-qiskit
python-zxing-cpp         # normcap

# PARKED (not in v1 scope):
# burpsuite: BlackArch repo arrives in Phase 2, not day-1 ISO.
# dvc, cut in R3.1 P1: generic data tool, pip-installable, ~17-pkg AUR tail.
# snakemake, cut in R3.1 P1: generic workflow tool, ~16-pkg AUR tail.
# celestia (+gtk2, gtkglext), parked in R3.1 P3 (Codex counter accepted):
#   EOL GTK2 runtime is a supportability liability, not just a build risk;
#   Stellarium (official repos, on the ISO) covers planetarium duty.
#   Re-introduce only with a maintained dependency path.

# NOT AVAILABLE FROM THE AUR (checked 2026-09-06 via RPC search by name and by
# name-desc: zero hits for kxkb, locale1, kxkb2locale; absent from Arch too):
# kxkb2locale1: a daemon that watches the KDE keyboard configuration and applies
#   it to org.freedesktop.locale1, so layout switching works in a live session.
#   Upstream is KDE Invent (https://invent.kde.org/aleasto/kxkb2locale1, MIT);
#   what the ISO used was CachyOS's own VCS build of it, carrying a local
#   remove-env-check.patch. depends qt6-base, kconfig; makedepends git, cmake,
#   extra-cmake-modules (all official). No AUR name exists, so it cannot enter
#   this lane: a name here that the D7 liveness check cannot resolve hard-fails
#   the preflight for the whole scope. If the ISO still needs it, it belongs in
#   the local lane (astroos/pkgs/), built from the KDE upstream.
