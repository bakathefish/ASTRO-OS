# Machine-to-machine (beat macOS: Universal Control / Sidecar / content sync)
input-leap
syncthing
# krfb-virtualmonitor ships with krfb / plasma; listed for clarity
krfb

# Phone mirroring
scrcpy

# QR utility
qrencode

# Native iPhone/Mac AirDrop receive (OpenDrop + OWL): AUR, see aur.list
# opendrop, owl (owlink) installed via AUR bootstrap
