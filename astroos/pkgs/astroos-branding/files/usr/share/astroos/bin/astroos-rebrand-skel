#!/bin/sh
# Put the AstroOS terminal greeting into the bash skeleton (run by
# 86-astroos-skel.hook). The installer gives users bash (users.conf shell:
# /bin/bash) and only fish ships a greeting of its own, so without this a new
# user's first terminal is bare where a fish user gets the AstroOS logo.
#
# /etc/skel/.bashrc is owned by the bash package, so this appends rather than
# replaces, and the grep guard makes the append idempotent across upgrades.
#
# The Kickoff icon, the default wallpaper and the Alacritty window title used to
# be sed'd here too, back when those skeleton files came from cachyos-kde-settings
# and cachyos-alacritty-config. astroos-kde-settings ships them branded now and
# nothing in AstroOS installs an Alacritty config, so those edits are gone.
b=/etc/skel/.bashrc
if [ -f "$b" ] && ! grep -q 'AstroOS terminal greeting' "$b"; then
  printf '\n# AstroOS terminal greeting (fastfetch with the AstroOS logo); delete to disable\n[[ $- == *i* ]] && command -v fastfetch >/dev/null 2>&1 && fastfetch\n' >> "$b"
fi
exit 0
