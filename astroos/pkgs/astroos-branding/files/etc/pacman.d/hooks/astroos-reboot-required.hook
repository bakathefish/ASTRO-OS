# AstroOS copy of cachyos-hooks' cachyos-reboot-required.hook (GPL-3.0-or-later):
# same trigger set, AstroOS notification header. The CachyOS hook is masked by
# a /dev/null symlink of the same name in this directory.
[Trigger]
Operation = Upgrade
Type = Package
Target = amd-ucode
Target = intel-ucode
Target = btrfs-progs
Target = e2fsprogs
Target = xfsprogs
Target = cryptsetup
Target = linux
Target = linux-hardened
Target = linux-lts
Target = linux-zen
Target = linux-firmware
Target = linux-cachyos*
Target = linux-cacule*
Target = nvidia
Target = nvidia-dkms
Target = nvidia-*xx-dkms
Target = nvidia-*xx
Target = nvidia-*lts-dkms
Target = nvidia*-lts
Target = mesa
Target = systemd*
Target = wayland
Target = egl-wayland
Target = xf86-video-*
Target = xorg-server*
Target = xorg-fonts*
Target = mkinitcpio*
Target = booster*
Target = dracut*
Target = winesync-dkms

[Action]
Description = AstroOS: check whether a reboot is recommended after this upgrade
When = PostTransaction
NeedsTargets
Exec = /usr/share/astroos/bin/astroos-reboot-required
