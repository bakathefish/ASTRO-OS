# The bash skeleton is the one login shell whose greeting nobody packages.
# /etc/skel/.bashrc belongs to the bash package and is not in a backup array, so
# AstroOS cannot ship it; this hook appends the fastfetch greeting after every
# install/upgrade of bash instead. The append is guarded by a grep, so running
# it twice adds nothing.
#
# It used to do more: while the skeleton KDE and Alacritty configs came from
# cachyos-kde-settings and cachyos-alacritty-config, it also sed'd the Kickoff
# icon and the default wallpaper into them (R4 survey rows 6, 7, 13).
# astroos-kde-settings now ships those files already branded and no AstroOS
# profile carries an Alacritty config, so only the bash half is left.
[Trigger]
Operation = Install
Operation = Upgrade
Type = Package
Target = bash
Target = astroos-branding

[Action]
Description = AstroOS: add the terminal greeting to the bash skeleton
When = PostTransaction
Exec = /usr/share/astroos/bin/astroos-rebrand-skel
