# AstroOS distro identity enforcement, and the only thing on the system that
# writes /etc/os-release, /etc/lsb-release, /etc/issue and /etc/motd.
#
# Why it is named zz-: the files it owns belong to other packages (filesystem
# owns os-release and issue, lsb-release owns lsb-release), so pacman restores
# the upstream text on every upgrade of the owner and the identity has to be
# re-asserted afterwards. The zz- prefix sorts this hook after every stock hook
# in the directory, so nothing runs after it and undoes the result.
#
# Historical note, because it is the reason this design exists rather than a
# plain drop-in file: while AstroOS was built on CachyOS packages, cachyos-hooks
# shipped {cachyos-branding,os-release,lsb-release}.hook, whose script sed'd the
# identity back to CachyOS on every trigger. That clobbered the pre-placed
# identity in ISO build 13. Those hooks are gone with the package, and the
# same-named /dev/null masks that used to sit beside this file went with them:
# the hook names they masked are now names AstroOS itself could ship, so leaving
# the masks in place would have silenced our own hooks.
#
# It runs at pacstrap time for installed systems (filesystem and this package
# land in one transaction) and again after every relevant upgrade.
[Trigger]
Operation = Install
Operation = Upgrade
Type = Package
Target = filesystem
Target = lsb-release
Target = astroos-settings
Target = astroos-branding

[Action]
Description = AstroOS: enforce distro identity (os-release, lsb-release, issue, motd)
When = PostTransaction
Exec = /usr/share/astroos/bin/astroos-identity
