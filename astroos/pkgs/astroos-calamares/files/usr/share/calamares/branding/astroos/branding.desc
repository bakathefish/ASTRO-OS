---
# AstroOS Calamares branding component. Layout and keys follow the CachyOS
# component shipped by astroos-calamares-installer, the AstroOS build of the
# CachyOS Calamares fork (R4 branding survey section 2);
# images are generated by astroos/branding/assetgen.py.
componentName:  astroos

welcomeStyleCalamares:   false
welcomeExpandingLogo:   true

windowExpanding:    normal
windowSize: 1100px,520px
windowPlacement: center

sidebar: qml,bottom
navigation: widget

strings:
    productName:         AstroOS
    shortProductName:    AstroOS
    version:             rolling
    shortVersion:        rolling
    versionedName:       AstroOS
    shortVersionedName:  AstroOS
    bootloaderEntryName: AstroOS
    productUrl:          https://github.com/bakathefish/ASTRO-OS
    supportUrl:          https://github.com/bakathefish/ASTRO-OS/issues
    knownIssuesUrl:      https://github.com/bakathefish/ASTRO-OS/issues
    releaseNotesUrl:     https://github.com/bakathefish/ASTRO-OS/releases

images:
    productLogo:         "logo.png"
    productIcon:         "icon.png"
    productWelcome:      "welcome.png"

# Sidebar, in AstroOS palette roles (astroos/branding/PALETTE.md): header for
# the bar, text_sub for the steps still to come, and the current step drawn as
# a selection, selection_text on lavender, the same pair the desktop uses.
# The key names are the StyleEntry enum spelled exactly as C++ declares it:
# Branding::styleString() looks each one up with QMetaEnum::valueToKey, and
# validateStyleEntries() rejects anything else with "Unknown branding *style*
# entry" (Calamares 3.4.1, src/libcalamaresui/Branding.cpp and Branding.h).
style:
   SidebarBackground:        "#161129"
   SidebarText:              "#c8c4de"
   SidebarTextCurrent:       "#f8e2f6"
   SidebarBackgroundCurrent: "#8658b4"

slideshow:               "show.qml"
slideshowAPI: 2
