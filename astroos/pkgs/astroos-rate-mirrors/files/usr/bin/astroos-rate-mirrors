#!/usr/bin/env bash
# astroos-rate-mirrors: rank the Arch Linux mirrors and rewrite
# /etc/pacman.d/mirrorlist. That is the whole job.
#
# /etc/pacman.d/astroos-mirrorlist is deliberately left alone. AstroOS is
# served from a single origin, so that file (shipped by the astroos-mirrorlist
# package) holds one Server line and there is no mirror set to rank. It is a
# backup= file of that package as well, so rewriting it would only produce
# .pacnew churn. Nothing below writes to it.
#
# Derived from the CachyOS package of the same purpose (GPL).
#
# Copyright (C) 2022-2026 CachyOS team
# Copyright (C) 2026 AstroOS
#
# This program is free software; you can redistribute it and/or modify
# it under the terms of the GNU General Public License as published by
# the Free Software Foundation; either version 2 of the License, or
# (at your option) any later version.
#
# This program is distributed in the hope that it will be useful,
# but WITHOUT ANY WARRANTY; without even the implied warranty of
# MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
# GNU General Public License for more details.
#
# You should have received a copy of the GNU General Public License along
# with this program; if not, write to the Free Software Foundation, Inc.,
# 51 Franklin Street, Fifth Floor, Boston, MA 02110-1301 USA.
set -e

declare -r MIRRORS_DEFAULT_DIR="/etc/pacman.d"
declare -r ARCH_MIRRORLIST="${MIRRORS_DEFAULT_DIR}/mirrorlist"
declare -r ASTROOS_MIRRORLIST="${MIRRORS_DEFAULT_DIR}/astroos-mirrorlist"

usage() {
    cat <<'EOF'
Usage: astroos-rate-mirrors

Ranks the Arch Linux mirrors by measured speed (rate-mirrors) and rewrites
/etc/pacman.d/mirrorlist, keeping the previous list as mirrorlist-backup.
Must run as root. The AstroOS repository is served from a single origin and
is not ranked.

Overrides go in /etc/conf.d/astroos-rate-mirrors.env, one KEY=value per line;
every RATE_MIRRORS_* variable rate-mirrors understands is honoured, e.g.

    RATE_MIRRORS_ENTRY_COUNTRY=DE
    RATE_MIRRORS_MAX_DELAY=20000

astroos-rate-mirrors.timer runs this about every ten days.
EOF
}

case "${1:-}" in
    -h|--help) usage; exit 0 ;;
    "") ;;
    *) echo "astroos-rate-mirrors: unknown argument '$1'" >&2; usage >&2; exit 2 ;;
esac

if [ -f /etc/conf.d/astroos-rate-mirrors.env ]; then
    set -a
    . /etc/conf.d/astroos-rate-mirrors.env
    set +a
fi

# Use https only protocol for rating
export RATE_MIRRORS_PROTOCOL=https
export RATE_MIRRORS_FETCH_MIRRORS_TIMEOUT="${RATE_MIRRORS_FETCH_MIRRORS_TIMEOUT:-30000}"
export RATE_MIRRORS_ALLOW_ROOT=true
export RATE_MIRRORS_MAX_DELAY="${RATE_MIRRORS_MAX_DELAY:-10000}"

disable_colors() {
    unset ALL_OFF BOLD BLUE GREEN RED YELLOW
}

enable_colors() {
    # prefer terminal safe colored and bold text when tput is supported
    if tput setaf 0 &>/dev/null; then
        ALL_OFF="$(tput sgr0)"
        BOLD="$(tput bold)"
        RED="${BOLD}$(tput setaf 1)"
        GREEN="${BOLD}$(tput setaf 2)"
        YELLOW="${BOLD}$(tput setaf 3)"
        BLUE="${BOLD}$(tput setaf 4)"
    else
        ALL_OFF="\e[0m"
        BOLD="\e[1m"
        RED="${BOLD}\e[31m"
        GREEN="${BOLD}\e[32m"
        YELLOW="${BOLD}\e[33m"
        BLUE="${BOLD}\e[34m"
    fi
    # shellcheck disable=SC2034
    readonly ALL_OFF BOLD BLUE GREEN RED YELLOW
}

if [[ -t 2 ]]; then
    enable_colors
else
    disable_colors
fi

msg() {
    local mesg="$1"; shift
    # shellcheck disable=SC2059
    printf "${GREEN}==>${ALL_OFF}${BOLD} ${mesg}${ALL_OFF}\n" "$@" >&2
}

info() {
    local mesg="$1"; shift
    # shellcheck disable=SC2059
    printf "${YELLOW} -->${ALL_OFF}${BOLD} ${mesg}${ALL_OFF}\n" "$@" >&2
}

error() {
    local mesg="$1"; shift
    # shellcheck disable=SC2059
    printf "${RED}==> ERROR:${ALL_OFF}${BOLD} ${mesg}${ALL_OFF}\n" "$@" >&2
}

cleanup() {
    exit "${1:-0}"
}

die() {
    (($#)) && error "$@"
    cleanup 255
}

if [ "$EUID" -ne 0 ]; then
    die "Please, run script as root"
fi

# We declare and assign as a r/o variable.
# shellcheck disable=SC2155
declare -r TMPFILE="$(mktemp)"
trap 'rm -f -- "$TMPFILE"' EXIT

rate_repository_mirrors() {
    local repo="$1"
    local path="$2"

    info "Ranking mirrors for ${repo} repository in ${path}..."

    if rate-mirrors --save "$TMPFILE" "$repo"; then
        if [ ! -f "${path}" ]; then
            die "${path} doesn't exist! You must install package $(pacman -Fq "$path" 2>/dev/null || echo "that contains $path")"
        fi
        install -m 0644 --backup=simple --suffix="-backup" "${TMPFILE}" "${path}"
        msg "Done [${repo}] ${path}"
    else
        die "rate-mirrors failed [errcode=$?]."
    fi
}

country=""
if [ -z "$RATE_MIRRORS_ENTRY_COUNTRY" ]; then
    msg "Entry country not set, trying to detect..."
    # Prefer mirrors that are geographically close, especially in countries that
    # have regional blockages
    country="$(curl --connect-timeout 10 -sSL 'https://geoip.kde.org/v1/ubiquity' | grep -Po '<CountryCode>\K([A-Z]{2})' || true)"

    if [ -n "$country" ]; then
        export RATE_MIRRORS_ENTRY_COUNTRY="$country"
    fi
fi
info "Using entry country: ${RATE_MIRRORS_ENTRY_COUNTRY:-"none"}"

# China only tests its own mirrors, so disable neighbors
# and increase the number of tested mirrors to get more results
if [ "$country" = "CN" ]; then
    export RATE_MIRRORS_COUNTRY_NEIGHBORS_PER_COUNTRY=0
    export RATE_MIRRORS_COUNTRY_TEST_MIRRORS_PER_COUNTRY=50
fi

rate_repository_mirrors arch "${ARCH_MIRRORLIST}"

# The AstroOS repository has one server, named directly in pacman.conf. There
# is no mirror set to rank, so nothing here writes to astroos-mirrorlist.
if [ -f "${ASTROOS_MIRRORLIST}" ]; then
    info "Left ${ASTROOS_MIRRORLIST} untouched: AstroOS is served from a single origin."
else
    info "Only the Arch mirrors were ranked: AstroOS is served from a single origin."
fi
