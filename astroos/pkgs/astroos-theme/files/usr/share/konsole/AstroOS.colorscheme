# The AstroOS terminal palette. Every value comes from a role in
# astroos/branding/palette.py: the sixteen ANSI slots are its ANSI table, so
# red is still the error colour and green still success, and only the hues are
# pulled into the brand. Format follows konsole data/color-schemes/*.
#
# ColorNFaint is the same as ColorN on purpose. Konsole's faint variants are
# free colours, and Breeze fills them with darkened mixes; a mix of a palette
# colour is not a palette colour, so faint text here is the ordinary colour and
# the palette stays closed. The intense variants are the bright_ roles, which
# the palette already defines.

[Background]
Color=18,14,34

[BackgroundFaint]
Color=18,14,34

[BackgroundIntense]
Color=18,14,34

[Color0]
Color=27,22,48

[Color0Faint]
Color=27,22,48

[Color0Intense]
