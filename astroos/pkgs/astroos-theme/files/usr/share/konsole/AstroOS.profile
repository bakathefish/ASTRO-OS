# The AstroOS Konsole profile: the colour scheme and nothing else. Font,
# scrollback, transparency and the rest stay at Konsole's own defaults, which
# is what Parent=FALLBACK/ means, so a user who changes any of them keeps the
# change. astroos-kde-settings points konsolerc at this profile for new users.

[Appearance]
ColorScheme=AstroOS

[General]
Name=AstroOS
Parent=FALLBACK/
