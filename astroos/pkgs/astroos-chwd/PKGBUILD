# Maintainer: AstroOS <https://github.com/bakathefish/ASTRO-OS>
# Contributor: Vladislav Nepogodin <nepogodin.vlad@gmail.com>
# Contributor: Vasiliy Stelmachenok <ventureo@yandex.ru>
#
# Derived from the CachyOS project of the same name (GPL).
#
# AstroOS rebuild of chwd so the ISO can drop the [cachyos] repo. Only the
# PACKAGE name changes. The BINARY stays /usr/bin/chwd: the Calamares chwd
# module invokes it by name, and the tool's own data paths (/var/lib/chwd/db,
# /local, /scripts) are compiled into it (src/consts.rs, upstream 1.24.1).
#
# Source: upstream builds from a git tag it verifies with its own OpenPGP key.
# The [astroos] lane trusts only the AstroOS key (KEYS.md), so instead of
# carrying a second trust root we pin the GitHub archive of that exact tag and
# verify it by hash. Tag 1.24.1 is commit
# e99ec339715f2b5724a1adc100ea55b94e59df5a; the sums below were taken from two
# independent downloads on 2026-09-06 and matched.
#
# Nothing inside this package needs a cachyos-to-astroos rename, and that is a
# finding, not an omission:
#   - the binary prints no distro name. Its clap `about` is empty (the root
#     Cargo.toml carries no `description`) and i18n/en/chwd.ftl is neutral, so
#     `chwd --help` and every runtime message are already distro-free.
#   - every path it installs or reads is /var/lib/chwd/**, never a cachyos one.
#   - the `linux-cachyos` prefix matches in profiles/pci/graphic_drivers/
#     profiles.toml and scripts/chwd-kernel are FUNCTIONAL, not branding: they
#     decide which kernel gets a prebuilt nvidia module. AstroOS ships
#     linux-astroos and linux-astroos-lts (astroos/meta/astroos-core.list), so
#     prepare() retargets them at our prefix; left alone, the nvidia profile
#     would fall through to nvidia-open-dkms on every AstroOS kernel.
# The one CachyOS string this package did own was the pkgdesc, renamed below.
# The Calamares progress line "Installing needed drivers for CachyOS..." is not
# ours; astroos-calamares rewrites it (apply.sh).

pkgname=astroos-chwd
pkgver=1.24.1
pkgrel=1
pkgdesc="AstroOS hardware detection: matches PCI/USB devices to driver profiles and installs them (chwd)"
arch=(x86_64)
url="https://github.com/CachyOS/chwd"
# upstream's own PKGBUILD declares this. Note upstream is not self-consistent:
# Cargo.toml says GPL-3.0-only and the file headers say GPLv2-or-later, so the
# LICENSE text is installed below rather than relying on the common licence.
license=(GPL-3.0-or-later)
depends=(gcc-libs pciutils lua pacman libusb libusb-1.0.so)
# git is kept from upstream: cargo still needs it if the registry protocol is
# set to git rather than the sparse default. No crate in either Cargo.lock is
# a git source, so nothing else here reaches for it.
makedepends=(git cargo lld clang llvm)
# chwd-db was folded into chwd upstream long ago; carried over so an installed
# system with either old name upgrades cleanly onto this package.
provides=(chwd chwd-db)
conflicts=(chwd chwd-db)
replaces=(chwd chwd-db)
_src="chwd-$pkgver"
source=("$_src.tar.gz::$url/archive/refs/tags/$pkgver.tar.gz"
        0001-installed-db-without-the-cachyos-libalpm-patch.patch)
sha256sums=('0610cb65a0df2da75f1cf8a8a3369478f726c1e77a9088f612c35507e984a53a'
            '7b3f9d33cc546f547fca8f2a733cee85296eb717dad3bde35d075fb4adc53508')
b2sums=('2a19da62dd23ee96cbdc0f0e7a77ff1904e858b94170b7d026a4904f1892c34f3e00997b3ed38016d2c96105bc742bbc04e199cb053afe24f684e9826111eb5a'
        '2c240c6484e461f28883cef35421dc0ded8994319157573c226db3dd847be1baf041e98be4e2f066a2782606ad8ad2b0699d673fd9d3d296183cc8980e740bde')

prepare() {
  cd "$srcdir/$_src"

  # The kernel-name prefix that selects a prebuilt module package: the nvidia
  # profile turns each /usr/lib/modules/*/pkgbase into "<kernel>-nvidia-open"
  # only when the kernel matches, and chwd-kernel attaches -zfs/-nvidia-open
  # names the same way. Our kernels are linux-astroos*, and their module
  # packages follow (linux-astroos-nvidia-open, linux-astroos-zfs). The
  # handheld profiles are left alone: they symlink into
  # /usr/share/cachyos-handheld, a package outside the AstroOS scope, and a
  # symlink into a package the user could still install beats one into a
  # path nothing owns.
  sed -i 's/linux-cachyos/linux-astroos/g' \
    profiles/pci/graphic_drivers/profiles.toml \
    scripts/chwd-kernel/src/kernel.rs
  grep -q 'grep -q "^linux-astroos"' profiles/pci/graphic_drivers/profiles.toml \
    || { echo "!! the nvidia profile no longer matches the kernel by prefix (chwd moved?)" >&2; return 1; }
  grep -q 'starts_with("linux-astroos")' scripts/chwd-kernel/src/kernel.rs \
    || { echo "!! chwd-kernel no longer matches the kernel by prefix (chwd moved?)" >&2; return 1; }
  # chwd-kernel binds alpm_pkg_get_installed_db by hand: a CachyOS patch to
  # libalpm (their pacman records the repo a package was installed from) that
  # Arch's pacman does not export, so the link fails on the symbol here. The
  # patch derives that field from the sync repo carrying the package instead;
  # the TUI shows the same name on a system whose kernels come from one repo.
  patch -Np1 -i "$srcdir/0001-installed-db-without-the-cachyos-libalpm-patch.patch"
  grep -q 'alpm_pkg_get_installed_db(' scripts/chwd-kernel/src/kernel.rs \
    && { echo "!! the libalpm binding survived the patch" >&2; return 1; }

  cargo fetch --locked --target "$CARCH-unknown-linux-gnu"

  # separate crate, not a workspace member: it has its own Cargo.lock
  cd scripts/chwd-kernel
  cargo fetch --locked --target "$CARCH-unknown-linux-gnu"
}

build() {
  cd "$srcdir/$_src"

  # upstream's toolchain choice (clang + lld), kept verbatim
  export AR=llvm-ar
  export CC=clang
  export CXX=clang++
  export NM=llvm-nm
  export RANLIB=llvm-ranlib

  export RUSTFLAGS="-Cembed-bitcode -C opt-level=3 -Ccodegen-units=1 -Clinker=clang -C link-arg=-flto -Clink-arg=-fuse-ld=/usr/bin/ld.lld"

  cd scripts/chwd-kernel
  cargo build --release --frozen

  cd ../../

  cargo build --release --frozen
}

package() {
  cd "$srcdir/$_src"

  # the binary name is load-bearing: Calamares and the hooks call `chwd`
  install -Dm755 "target/release/chwd" "$pkgdir/usr/bin/chwd"
  # the lua transaction runner chwd execs (CHWD_SCRIPT_PATH in src/consts.rs)
  install -Dm755 scripts/chwd "$pkgdir"/var/lib/chwd/scripts/chwd

  # completions are generated by build.rs from the clap definition, so they
  # carry the `chwd` command name and no distro string
  install -Dm644 target/release/build/chwd-*/out/chwd.bash "$pkgdir/usr/share/bash-completion/completions/chwd"
  install -Dm644 target/release/build/chwd-*/out/chwd.fish "$pkgdir/usr/share/fish/vendor_completions.d/chwd.fish"
  install -Dm644 target/release/build/chwd-*/out/_chwd "$pkgdir/usr/share/zsh/site-functions/_chwd"

  # db/ is the shipped profile set, local/ is where installed profiles are
  # recorded. chwd checks for db/pci and local/pci at startup and creates the
  # usb halves on demand (misc::check_environment, install_profile).
  install -d -m755 "$pkgdir"/var/lib/chwd/{db,local}/pci

  # vendor/device id lists the profiles match against
  install -d -m755 "$pkgdir"/var/lib/chwd/ids
  cp -r ids/* "$pkgdir"/var/lib/chwd/ids

  cp -r profiles/pci "$pkgdir"/var/lib/chwd/db/
  cp -r profiles/usb "$pkgdir"/var/lib/chwd/db/

  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"

  cd scripts/chwd-kernel
  install -Dm755 "target/release/chwd-kernel" "$pkgdir/usr/bin/chwd-kernel"
}

# vim:set sw=2 sts=2 et:
