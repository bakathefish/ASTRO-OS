# Re-assert the AstroOS identity files after this package lands.
# Derived from the CachyOS package of the same purpose (GPL): upstream
# cachyos-hooks' cachyos-branding.hook, Target retargeted cachyos-hooks ->
# astroos-hooks.
#
# On an installed system astroos-branding also ships
# /etc/pacman.d/hooks/zz-astroos-identity.hook, which sorts after this one and
# copies its staged identity files over the result. The two agree by
# construction: /usr/share/libalpm/scripts/astroos-branding writes exactly the
# values astroos-branding stages.
[Trigger]
Operation = Install
Operation = Upgrade
Type = Package
Target = astroos-hooks

[Action]
Description = Updating AstroOS specific configuration.
When = PostTransaction
Exec = /usr/share/libalpm/scripts/astroos-branding
