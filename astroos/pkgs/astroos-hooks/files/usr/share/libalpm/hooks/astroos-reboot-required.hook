# Notify that a reboot is recommended after a core system package upgrade.
# Derived from the CachyOS package of the same purpose (GPL): upstream
# cachyos-hooks' cachyos-reboot-required.hook. Target list is upstream's apart
# from linux-cachyos* -> linux-astroos* (which covers linux-astroos-lts and the
# -headers, -nvidia-open and -zfs suffixes). linux-cacule* is the CacULE
# scheduler kernel, a third-party name, so it is left alone. The Description is
# the AstroOS one, so the pacman transaction line names the distro running it.
#
# This is the only reboot notification AstroOS ships. astroos-branding used to
# carry a same-named copy under /etc/pacman.d/hooks, which overrode this one
# while cachyos-hooks was still in the picture; that copy is gone, and its
# AstroOS wording lives on in the Description below and in the script's
# notification strings.
[Trigger]
Operation = Upgrade
Type = Package
Target = amd-ucode
Target = intel-ucode
Target = btrfs-progs
Target = e2fsprogs
Target = xfsprogs
Target = cryptsetup
Target = linux
Target = linux-hardened
Target = linux-lts
Target = linux-zen
Target = linux-firmware
Target = linux-astroos*
Target = linux-cacule*
Target = nvidia
Target = nvidia-dkms
Target = nvidia-*xx-dkms
Target = nvidia-*xx
Target = nvidia-*lts-dkms
Target = nvidia*-lts
Target = mesa
Target = systemd*
Target = wayland
Target = egl-wayland
Target = xf86-video-*
Target = xorg-server*
Target = xorg-fonts*
Target = mkinitcpio*
Target = booster*
Target = dracut*
Target = winesync-dkms

[Action]
Description = AstroOS: check whether a reboot is recommended after this upgrade
When = PostTransaction
NeedsTargets
Exec = /usr/share/libalpm/scripts/astroos-reboot-required
