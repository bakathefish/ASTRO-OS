#!/usr/bin/env bash
# Run AstroOS hooks related commands.
#
# Derived from the CachyOS package of the same purpose (GPL): upstream
# cachyos-hooks' cachyos-branding script (GPL-3.0-or-later),
# https://github.com/CachyOS/cachyos-hooks
#
# Every value below is the one astroos-branding stages in
# /usr/share/astroos/branding, not a literal string rename of the CachyOS value,
# so the two packages can never disagree about the system identity. That is
# also why ID stays "arch": AstroOS is an Arch derivative and tooling that keys
# off ID=arch keeps working. Upstream needed an ID_LIKE fixup because it sets
# ID=cachyos; here ID_LIKE would only name the distro as like itself, so the
# fixup is dropped.

update_lsb_release() {
    sed -i /etc/lsb-release \
        -e 's|^DISTRIB_ID=.*$|DISTRIB_ID=AstroOS|' \
        -e 's|^DISTRIB_DESCRIPTION=.*$|DISTRIB_DESCRIPTION=\"AstroOS\"|'
}

update_os_release() {
    local os_release="/etc/os-release"
    sed -i "$os_release" \
        -e 's|^NAME=.*$|NAME=\"AstroOS\"|' \
        -e 's|^PRETTY_NAME=.*$|PRETTY_NAME=\"AstroOS\"|' \
        -e 's|^ID=.*$|ID=arch|' \
        -e 's|^ANSI_COLOR=.*$|ANSI_COLOR=\"38;2;216;160;223\"|' \
        -e 's|^HOME_URL=.*$|HOME_URL=\"https://github.com/bakathefish\"|' \
        -e 's|^DOCUMENTATION_URL=.*$|DOCUMENTATION_URL=\"https://github.com/bakathefish\"|' \
        -e 's|^SUPPORT_URL=.*$|SUPPORT_URL=\"https://github.com/bakathefish\"|' \
        -e 's|^BUG_REPORT_URL=.*$|BUG_REPORT_URL=\"https://github.com/bakathefish\"|' \
        -e 's|^LOGO=.*$|LOGO=astroos-logo|'
}

update_issues() {
    sed -i 's|Arch Linux|AstroOS|g' /etc/issue /usr/share/factory/etc/issue
}

case "$1" in
    os-release) update_os_release ;;
    lsb-release) update_lsb_release ;;
    *)
        update_os_release
        update_lsb_release
        update_issues
        ;;
esac
