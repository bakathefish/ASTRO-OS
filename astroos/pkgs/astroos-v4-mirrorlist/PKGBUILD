# Maintainer: AstroOS <https://github.com/bakathefish/ASTRO-OS>
# Local lane package (see astroos-keyring/PKGBUILD for the version scheme):
# built by astroos/scripts/build-aur-repo.sh from this directory, pkgver comes
# from the VERSION file that script writes.
#
# Replaces cachyos-v4-mirrorlist as part of dropping the [cachyos] repo. The
# CachyOS installer copies /etc/pacman.d/cachyos-v4-mirrorlist into the target
# (shellprocess_initialize_pacman.conf, .planning/R4_BRANDING_SURVEY.md line
# 22), so the AstroOS-named file has to exist at the matching path.
#
# It is deliberately inert: AstroOS publishes no x86_64_v4 repository, so the
# shipped file has no active Server line. This package exists for pacman.conf
# and installer compatibility, not because a v4 mirror exists.
pkgname=astroos-v4-mirrorlist
pkgver=0
pkgrel=1
pkgdesc="AstroOS x86_64_v4 repository mirrorlist (inert: AstroOS publishes no v4 repository)"
arch=(any)
url="https://github.com/bakathefish/ASTRO-OS"
license=(GPL-3.0-or-later)
provides=(cachyos-v4-mirrorlist)
conflicts=(cachyos-v4-mirrorlist)
replaces=(cachyos-v4-mirrorlist)
# keep a hand edited or ranked mirrorlist across upgrades (upstream does the same)
backup=(etc/pacman.d/astroos-v4-mirrorlist)

pkgver() { cat "$startdir/VERSION"; }

package() {
  install -Dm644 "$startdir/files/etc/pacman.d/$pkgname" \
    "$pkgdir/etc/pacman.d/$pkgname"
}
